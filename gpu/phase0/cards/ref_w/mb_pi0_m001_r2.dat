# Phase 0 stock weighted reference, generated by make_weighted_cards.py from mb_pi0_m005.dat (m_chi 1 MeV, replica 2).
model Dark_Photon
epsilon 1e-3
dark_matter_mass 0.001
dark_photon_mass 0.1
alpha_D 0.1
POT 2e20
pi0_per_POT 0.9
samplesize 1000000000
max_trials 62500000
seed 2026102903
burn_max 1000
burn_timeout 20000
beam_energy 8.9
production_channel pi0_decay
production_distribution pi0_sanfordwang
signal_channel NCE_electron
output_file events.dat
summary_file summary.dat
output_mode summary
max_scatter_energy 0.9
min_scatter_energy 0.035
detector sphere
x-position 0.0
y-position -1.9
z-position 491.0
radius 5.0
material Carbon
number_density 3.63471e22
proton_number 6
neutron_number 6
electron_number 6
mass 11.2593
material Hydrogen
number_density 7.26942e22
proton_number 1
neutron_number 0
electron_number 1
mass 0.945778
weighted true
