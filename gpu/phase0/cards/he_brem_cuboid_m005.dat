# Phase 0 reference: generic 120 GeV proton brem (zmin 0.1, zmax 0.9, ptmax 1.0), unrotated cuboid at 500 m.
model Dark_Photon
epsilon 1e-3
dark_matter_mass 0.005
dark_photon_mass 0.1
alpha_D 0.1
POT 1e20
samplesize 1000000000
max_trials 20000000
seed 20261031
burn_max 1000
burn_timeout 20000
beam_energy 120
production_channel V_decay
production_distribution proton_brem
zmin 0.1
zmax 0.9
ptmax 1.0
signal_channel NCE_electron
output_file events.dat
summary_file summary.dat
output_mode comprehensive
max_scatter_energy 120
min_scatter_energy 0.035
detector cuboid
x-position 0.0
y-position -2.0
z-position 500.0
width 3.0
height 3.0
length 10.0
det-phi 0.0
det-theta 0.0
det-psi 0.0
material Carbon
number_density 3.63471e22
proton_number 6
neutron_number 6
electron_number 6
mass 11.2593
material Hydrogen
number_density 7.26942e22
proton_number 1
neutron_number 0
electron_number 1
mass 0.945778
