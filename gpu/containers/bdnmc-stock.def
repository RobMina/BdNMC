Bootstrap: docker
From: gcc:14.2.0

# Stock BdNMC as a shared library (libBdNMC, C API in src/BdNMC_capi.h) and its command-line program, from the
# fork's shared_library branch, installed under /opt/bdnmc/{lib,include,bin}. For stock runs on any endpoint, and as
# the base for experiment images on a current OS that call BdNMC in process.
# Not for NOvASoft: an in-process build there must use the experiment's own SL7 compiler and libstdc++ (see the
# experiment integration repositories).
# The same compiler and glibc as the stock reference runs of docs/test-environments.md (C1, container build).
# Build (the user builds images): see gpu/containers/README.md.

%arguments
    BDNMC_REF=shared_library

%post
    git clone https://github.com/RobMina/BdNMC.git /opt/BdNMC-src
    git -C /opt/BdNMC-src checkout "{{ BDNMC_REF }}"
    git -C /opt/BdNMC-src submodule update --init  # most stock sources are in BdNMC_LANL (lanl/BdNMC_LANL)
    cd /opt/BdNMC-src/build
    make CXXFLAGS="-std=c++14 -O2 -fPIC" -j"$(nproc)" all
    make install PREFIX=/opt/bdnmc
    cp -r /opt/BdNMC-src/data /opt/bdnmc/data
    git -C /opt/BdNMC-src rev-parse HEAD > /opt/bdnmc/COMMIT

%environment
    export LD_LIBRARY_PATH=/opt/bdnmc/lib:${LD_LIBRARY_PATH:-}
    export PATH=/opt/bdnmc/bin:$PATH
    export BDNMC_DATA=/opt/bdnmc/data

%runscript
    # stock opens data/*.dat relative to the working directory
    cd /opt/bdnmc && exec /opt/bdnmc/bin/BDNMC "$@"

%labels
    Description Stock BdNMC (libBdNMC + CLI) from the shared_library branch
